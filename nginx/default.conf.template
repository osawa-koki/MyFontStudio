# 起動時に envsubst で ${PORT} を置き換える（nginx の変数は $uri のように波かっこなしで書く）
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    charset utf-8;

    gzip on;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # CSP（$csp）。中身は frontend/scripts/csp.mjs の contentSecurityPolicy() だけに書く（GitHub Pages の <meta> と同じ）。
    # 外部への通信を一切させない（手書きのデータをブラウザの外に出さない）。script-src には、Next.js の静的エクスポートが
    # HTML に埋め込むインラインのスクリプトの SHA-256 を入れる。Docker のビルドで scripts/csp-hashes.mjs が作る
    include /etc/nginx/csp.conf;

    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # Render は HTTPS で配信する。HTTP で来たら HTTPS に切り替えるようブラウザに覚えさせる
    add_header Strict-Transport-Security "max-age=31536000" always;
    # location の add_header（Cache-Control）を足しても、上のヘッダーを引き継ぐ
    add_header_inherit merge;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ファイル名にハッシュの付いたビルド成果物は長くキャッシュする
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # ページは事前に作った HTML（/editor でも /editor/ でも editor/index.html）。毎回確かめる
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/index.html $uri.html =404;
    }

    error_page 404 /404.html;
}
